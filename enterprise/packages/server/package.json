{
    "name": "@padloc/server-enterprise",
    "version": "4.3.1",
    "private": true,
    "description": "Padloc enterprise server composition",
    "license": "SEE LICENSE IN ../../../LICENSE-ENTERPRISE.txt",
    "repository": {
        "type": "git",
        "url": "https://github.com/padloc/padloc.git",
        "directory": "enterprise/packages/server"
    },
    "engines": {
        "node": "26.x",
        "npm": "11.20.0"
    },
    "dependencies": {
        "@padloc/core": "4.3.1",
        "@padloc/server": "4.3.1",
        "stripe": "8.212.0",
        "@types/stripe": "8.0.416"
    },
    "devDependencies": {
        "typescript": "5.6.3",
        "ts-node": "10.9.2",
        "mocha": "12.0.3",
        "chai": "4.3.4",
        "@types/chai": "4.2.18",
        "@types/mocha": "8.2.2"
    },
    "scripts": {
        "start": "cd ../../../packages/server && ts-node --project ../../enterprise/packages/server/tsconfig.json ../../enterprise/packages/server/src/init.ts",
        "start-dry": "cd ../../../packages/server && ts-node --project ../../enterprise/packages/server/tsconfig.json ../../enterprise/packages/server/src/init.ts --dryrun",
        "dev": "cd ../../../packages/server && node --watch --no-experimental-strip-types -r ts-node/register ../../enterprise/packages/server/src/init.ts",
        "test": "tsc --noEmit && mocha --no-experimental-strip-types -r ts-node/register test/*.ts --timeout 5000"
    }
}
