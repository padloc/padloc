{
    "name": "padloc",
    "private": true,
    "version": "4.3.0",
    "description": "A minimalist password manager",
    "author": "Martin Kleinschrodt <martin@maklesoft.com>",
    "license": "GPL-3.0",
    "homepage": "https://padloc.app/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/padloc/padloc.git"
    },
    "engines": {
        "node": "26.x",
        "npm": "11.20.0"
    },
    "main": "main.js",
    "devDependencies": {
        "@types/node": "26.6.5",
        "concurrently": "7.6.0",
        "cypress": "16.2.0",
        "http-server": "14.1.0",
        "maildev": "git+https://github.com/padloc/maildev.git#master",
        "prettier": "2.8.4",
        "ts-node": "10.9.2",
        "typescript": "5.6.3",
        "wait-on": "9.5.1"
    },
    "scripts": {
        "bootstrap": "npm ci",
        "pwa:build": "npm run build --workspace @padloc/pwa",
        "pwa:start": "npm run start --workspace @padloc/pwa",
        "server:start": "npm run start --workspace @padloc/server",
        "server:start-dry": "npm run start-dry --workspace @padloc/server",
        "electron:start": "npm run start --workspace @padloc/electron",
        "electron:build": "npm run build --workspace @padloc/electron",
        "electron:build:flatpak": "npm run build:flatpak --workspace @padloc/electron",
        "web-extension:build": "npm run build --workspace @padloc/extension",
        "cordova:start:android": "npm run start:android --workspace @padloc/cordova",
        "cordova:start:ios": "npm run start:ios --workspace @padloc/cordova",
        "cordova:build": "npm run cordova:build:android && npm run cordova:build:ios",
        "cordova:build:android": "npm run build:android --workspace @padloc/cordova",
        "cordova:build:android:signed": "npm run build:android:signed --workspace @padloc/cordova",
        "cordova:build:ios": "npm run build:ios --workspace @padloc/cordova",
        "cordova:build:ios:signed": "npm run build:ios:signed --workspace @padloc/cordova",
        "start": "npm run pwa:build && concurrently --kill-others \"npm run start --workspace @padloc/server\" \"npm run start --workspace @padloc/pwa\"",
        "start:v3": "http-server cypress/fixtures/v3-client -s -p 8081 --proxy http://0.0.0.0:8081?",
        "dev": "concurrently --kill-others \"npm run dev --workspace @padloc/server\" \"npm run dev --workspace @padloc/pwa\" \"npm run dev --workspace @padloc/admin\"",
        "tauri:dev": "concurrently --kill-others \"npm run dev --workspace @padloc/server\" \"npm run dev --workspace @padloc/tauri\"",
        "tauri:update": "npm run update-tauri --workspace @padloc/tauri",
        "tauri:build": "npm run build --workspace @padloc/tauri --",
        "tauri:build:debug": "npm run build:debug --workspace @padloc/tauri --",
        "repl": "npm run repl --workspace @padloc/server",
        "test": "npm run test --workspaces --if-present",
        "test:e2e": "concurrently --prefix=name --prefix-length=30 --kill-others --success=first -n app,v3-app,maildev,cypress \"PL_DATA_BACKEND=memory PL_DISABLE_SW=true PL_EMAIL_BACKEND=smtp PL_EMAIL_SMTP_HOST=localhost PL_EMAIL_SMTP_PORT=1025 PL_EMAIL_SMTP_IGNORE_TLS=true npm start\" \"npm run start:v3\" \"npx maildev\" \"./node_modules/.bin/wait-on tcp:localhost:8080 && CYPRESS_CRASH_REPORTS=0 cypress run\"",
        "test:e2e:dev": "concurrently --prefix=name --prefix-length=30 --kill-others --success=first -n app,v3-app,cypress \"PL_DATA_BACKEND=memory PL_DISABLE_SW=true PL_EMAIL_BACKEND=smtp PL_EMAIL_SMTP_HOST=localhost PL_EMAIL_SMTP_PORT=1025 PL_EMAIL_SMTP_IGNORE_TLS=true npm run dev\" \"npm run start:v3\" \"npx maildev\" \"./node_modules/.bin/wait-on tcp:localhost:8080 && CYPRESS_CRASH_REPORTS=0 cypress open\"",
        "locale:extract": "npm run extract --workspace @padloc/locale",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "admin:build": "npm run build --workspace @padloc/admin"
    },
    "workspaces": [
        "packages/*"
    ],
    "packageManager": "npm@11.20.0",
    "overrides": {
        "extract-zip@1.7.0": {
            "yauzl": "3.4.0"
        },
        "smtp-server": "3.20.2",
        "maildev": {
            "dompurify": "3.4.17",
            "socket.io": "4.8.4"
        },
        "external-editor": {
            "tmp": "0.2.7"
        },
        "xcode": {
            "uuid": "11.1.1"
        },
        "sockjs": {
            "uuid": "11.1.1"
        }
    }
}
