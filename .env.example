# Public URLs used by the PWA/Admin builds and server.
# For Dokploy, set these to your real public domains.
PL_PWA_URL=https://padloc.example.com
PL_SERVER_URL=https://padloc.example.com/server
PL_SERVER_CLIENT_URL=https://padloc.example.com

# Admin portal on a separate subdomain (recommended).
# Isolate sessions from the main PWA and allow separate edge access control later.
PL_ADMIN_URL=https://admin.padloc.example.com
PL_ADMIN_URL_PATH=/

# Super-admin emails for the Admin portal.
# Comma-separated. Must match an existing account email exactly.
# After changing this, restart `server` and log in again on the admin host.
PL_SERVER_ADMINS=you@example.com

# Email backend for auth codes, invites, and notifications.
# console prints mail to server logs. Switch to smtp for a real SMTP server.
PL_EMAIL_BACKEND=console
# Submission (STARTTLS): port 587, SECURE=false.
# Implicit TLS: port 465, SECURE=true.
# PL_EMAIL_SMTP_HOST=smtp.example.com
# PL_EMAIL_SMTP_PORT=587
# PL_EMAIL_SMTP_SECURE=false
# PL_EMAIL_SMTP_IGNORE_TLS=false
# PL_EMAIL_SMTP_USER=smtp_username
# PL_EMAIL_SMTP_PASSWORD=
# PL_EMAIL_SMTP_FROM=mail@example.com
