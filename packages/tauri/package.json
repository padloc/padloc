{
    "name": "@padloc/tauri",
    "version": "4.3.0",
    "description": "Tauri Wrapper for Padloc",
    "main": "index.js",
    "scripts": {
        "tauri": "tauri",
        "tauricon": "tauri icon",
        "build": "tauri build",
        "build:debug": "tauri build --debug --config src-tauri/tauri.local.conf.json",
        "dev": "tauri dev",
        "update-tauri": "cd src-tauri && cargo update",
        "setup-tauri": "cd src-tauri && cargo build",
        "update:config": "node build-tauri-conf.js",
        "test:release": "node test/release.js",
        "ios:init": "sh scripts/ios.sh init --skip-targets-install",
        "ios:build:sim": "sh scripts/ios.sh build --debug --target aarch64-sim --no-sign --ci",
        "ios:build:device": "sh scripts/ios.sh build --debug --target aarch64 --export-method debugging --ci",
        "ios:dev": "sh scripts/ios.sh dev"
    },
    "author": "Martin Kleinschrodt <martin@maklesoft.com>",
    "license": "GPL-3.0",
    "devDependencies": {
        "@iarna/toml": "2.2.5",
        "@tauri-apps/cli": "2.12.3",
        "clean-webpack-plugin": "3.0.0",
        "css-loader": "5.2.6",
        "dotenv": "10.0.0",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.3.1",
        "raw-loader": "4.0.2",
        "semver": "7.8.5",
        "style-loader": "2.0.0",
        "ts-loader": "9.2.2",
        "ts-node": "10.9.2",
        "typescript": "5.6.3",
        "webpack": "5.112.0",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "4.7.4"
    },
    "dependencies": {
        "@padloc/app": "4.3.0",
        "@padloc/core": "4.3.0",
        "@tauri-apps/api": "2.12.4",
        "@tauri-apps/plugin-clipboard-manager": "2.5.0",
        "@tauri-apps/plugin-process": "2.4.0",
        "@tauri-apps/plugin-updater": "2.14.0"
    },
    "engines": {
        "node": "26.x",
        "npm": "11.20.0"
    }
}
