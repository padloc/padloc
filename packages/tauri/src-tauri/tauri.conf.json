{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Padloc",
    "version": "4.3.0",
    "identifier": "app.padloc",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:8080",
        "beforeDevCommand": "npm run update:config && webpack serve",
        "beforeBuildCommand": "npm run update:config && npm run tauricon ../../assets/app-icon.png && webpack"
    },
    "app": {
        "windows": [
            {
                "title": "Padloc",
                "width": 1024,
                "height": 768,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "resources": [],
        "externalBin": [],
        "copyright": "",
        "category": "Productivity",
        "shortDescription": "",
        "longDescription": "",
        "macOS": {
            "minimumSystemVersion": "10.13"
        },
        "windows": {},
        "icon": [
            "icons/128x128.png",
            "icons/32x32.png",
            "icons/Square142x142Logo.png",
            "icons/Square284x284Logo.png",
            "icons/Square310x310Logo.png",
            "icons/Square71x71Logo.png",
            "icons/StoreLogo.png",
            "icons/icon.ico",
            "icons/128x128@2x.png",
            "icons/Square107x107Logo.png",
            "icons/Square150x150Logo.png",
            "icons/Square30x30Logo.png",
            "icons/Square44x44Logo.png",
            "icons/Square89x89Logo.png",
            "icons/icon.icns",
            "icons/icon.png"
        ],
        "createUpdaterArtifacts": "v1Compatible"
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://github.com/padloc/padloc/releases/latest/download/tauri-update.json"],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NDMxQ0I3MTA3NDU3RjIKUldUeVYzUVF0eHhET1ZpNUZDYWY3Zlk1aUN1ZkpXcU5wS0pSTERSay91ODBpWlBIcTViNk11RHgK"
        }
    }
}
